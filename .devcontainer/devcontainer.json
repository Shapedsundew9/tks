{
	"name": "The Knowledge Substrate",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"dockerComposeFile": [
		"docker-compose.yml",
		"docker-compose.shared.yml",
		"docker-compose.blender.yml"
	],
	"service": "app",
	// Add "neo4j" and/or "postgres" for experiments that need them.
	"runServices": [
		"app",
		"postgres",
		"ollama",
		"blender"
	],
	"workspaceFolder": "/workspace",
	"postCreateCommand": "bash .devcontainer/post-create.sh",
	"postStartCommand": "nohup bash scripts/llm/preload-model.sh > /tmp/ollama-preload.log 2>&1 &",
	"remoteUser": "vscode",
	"features": {
		"ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
			"version": "latest",
			"moby": false
		},
		"ghcr.io/devcontainers/features/github-cli:1": {
			"version": "latest"
		},
		"ghcr.io/devcontainers/features/node:2": {
			"version": "latest"
		}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"rust-lang.rust-analyzer",
				"tamasfe.even-better-toml",
				"vadimcn.vscode-lldb",
				"fill-labs.dependi",
				"eamodio.gitlens",
				"bierner.markdown-mermaid",
				"DavidAnson.vscode-markdownlint",
				"GitHub.vscode-pull-request-github",
				"ms-vscode.vscode-speech",
				"github.vscode-github-actions",
				"MermaidChart.vscode-mermaid-chart"
			],
			"settings": {
				"editor.formatOnSave": true,
				"rust-analyzer.check.command": "clippy",
				"rust-analyzer.check.allTargets": true,
				"rust-analyzer.cargo.allFeatures": true,
				"[rust]": {
					"editor.defaultFormatter": "rust-lang.rust-analyzer",
					"editor.formatOnSave": true
				},
				"[toml]": {
					"editor.defaultFormatter": "tamasfe.even-better-toml",
					"editor.formatOnSave": true
				},
				"[json]": {
					"editor.formatOnSave": true,
					"editor.defaultFormatter": "vscode.json-language-features"
				},
				"[jsonc]": {
					"editor.formatOnSave": true,
					"editor.defaultFormatter": "vscode.json-language-features"
				},
				"editor.codeActionsOnSave": {
					"source.fixAll.sortJSON": "explicit"
				}
			}
		}
	},
	"remoteEnv": {
		"DATABASE_URL": "${localEnv:TKS_DATABASE_URL:postgresql://postgres:postgres@postgres:5432/postgres}",
		"GITHUB_TOKEN": "${localEnv:COPILOT_GITHUB_TOKEN}",
		"ARC_AGI_API": "${localEnv:ARC_AGI_API}",
		"NEO4J_USERNAME": "${localEnv:NEO4J_USERNAME:neo4j}",
		"NEO4J_PASSWORD": "${localEnv:NEO4J_PASSWORD:password}",
		"NEO4J_DATABASE": "${localEnv:NEO4J_DATABASE:neo4j}",
		"HF_READ_TOKEN": "${localEnv:HF_READ_TOKEN}",
		"PYPI_USERNAME": "${localEnv:PYPI_USERNAME}",
		"PYPI_TOKEN": "${localEnv:PYPI_TOKEN}",
		"EMERGENT_MIND_BASE_URL": "${localEnv:EMERGENT_MIND_BASE_URL}",
		"EMERGENT_MIND_OPENAPI_SPEC_URL": "${localEnv:EMERGENT_MIND_OPENAPI_SPEC_URL}",
		"EMERGENT_MIND_TOKEN": "${localEnv:EMERGENT_MIND_TOKEN}",
		"CARGO_REGISTRY_URL": "${localEnv:CARGO_REGISTRY_URL}",
		"CARGO_REGISTRY_TOKEN": "${localEnv:CARGO_REGISTRY_TOKEN}",
		"DOCKER_HUB_USERNAME": "${localEnv:DOCKER_HUB_USERNAME}",
		"DOCKER_HUB_TOKEN": "${localEnv:DOCKER_HUB_TOKEN}",
		"OLLAMA_HOST": "http://ollama:11434",
		"TKS_LLM_BASE_URL": "http://ollama:11434/v1",
		"TKS_LLM_MODEL": "qwen3:8b",
		"OLLAMA_CONTEXT_LENGTH": "8192",
		"OLLAMA_NUM_PARALLEL": "1",
		"OLLAMA_KEEP_ALIVE": "-1",
		"OLLAMA_MAX_LOADED_MODELS": "1",
		"OLLAMA_FLASH_ATTENTION": "1",
		"BLENDERMCP_POLYPIZZA_API_KEY": "${localEnv:BLENDERMCP_POLYPIZZA_API_KEY}",
		"BLENDERMCP_SKETCHFAB_API_KEY": "${localEnv:BLENDERMCP_SKETCHFAB_API_KEY}",
		"GEMINI_API_KEY_SS": "${localEnv:GEMINI_API_KEY_SS}",
		"GEMINI_API_KEY_AM": "${localEnv:GEMINI_API_KEY_AM}",
		"GEMINI_API_KEY_JB": "${localEnv:GEMINI_API_KEY_JB}",
		"GROQ_API_KEY": "${localEnv:GROQ_API_KEY}",
		"OPENROUTER_API_KEY": "${localEnv:OPENROUTER_API_KEY}",
		"TIERFALL_ACCOUNT_ORDER": "gemini-ss,gemini-am,gemini-jb"
	}
}