.env
.envrc

# JetBrains / CLion
.idea/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Cursor
.cursorignore
.cursorindexingignore

# OS generated files
.DS_Store
Thumbs.db

# Node.js
node_modules/
package-lock.json

