# Generated by Cargo
# will have compiled start and library files
/target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows pdb files
*.pdb

# Environments and local secrets
.env
.envrc

# Trussflow run artifacts (raw agent input/output)
artifacts/

# JetBrains / CLion
.idea/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Cursor
.cursorignore
.cursorindexingignore

# OS generated files
.DS_Store
Thumbs.db

.fastembed_cache/
